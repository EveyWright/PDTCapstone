                },
                "metadata": {
                  "operationMetadataId": "097f1a93-c5c1-4a90-85f4-bcb8cdbc2c46"
                }
              }
            }
          },
          "cases": {
            "Case_resolve": {
              "actions": {
                "Updates_a_ticket_to_closed": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "parameters": {
                      "entityName": "f26c_tickets",
                      "recordId": "@outputs('Get_ticket')?['body/f26c_ticketid']",
                      "item/f26c_status": 751610002,
                      "item/f26c_worknotes": "@variables('notes')"
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                      "operationId": "UpdateOnlyRecord",
                      "connectionName": "shared_commondataserviceforapps"
                    }
                  },
                  "metadata": {
                    "operationMetadataId": "c8823b22-ac83-4572-8be4-d65e9b276ec2"
                  }
                },
                "Add_a_new_row_to_TicketUpdates_table_2": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "parameters": {
                      "entityName": "f26c_ticketupdates",
                      "item/f26c_TicketID@odata.bind": "@concat('f26c_tickets(', actions('Get_ticket')?['inputs']?['parameters']?['recordId'], ')')",
                      "item/f26c_UpdatedBy@odata.bind": "@concat('f26c_employees(', outputs('Get_assignee')?['body/f26c_employeeid'], ')')",
                      "item/f26c_updatedon": "@utcNow()",
                      "item/f26c_updatetype": 751610003,
                      "item/f26c_updatetext": "@variables('notes')"
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                      "operationId": "CreateRecord",
                      "connectionName": "shared_commondataserviceforapps"
                    }
                  },
                  "runAfter": {
                    "Updates_a_ticket_to_closed": [
                      "Succeeded"
                    ]
                  },
                  "metadata": {
                    "operationMetadataId": "6fb3ba27-778b-40b7-bbd5-032b80844a16"
                  }
                }
              },
              "case": "resolve"
            },
            "Case_skip": {
              "actions": {
                "Updates_a_ticket_to_skip": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "parameters": {
                      "entityName": "f26c_tickets",
                      "recordId": "@outputs('Get_ticket')?['body/f26c_ticketid']",
                      "item/f26c_status": 751610003,
                      "item/f26c_worknotes": "@variables('notes')"
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                      "operationId": "UpdateOnlyRecord",
                      "connectionName": "shared_commondataserviceforapps"
                    }
                  },
                  "metadata": {
                    "operationMetadataId": "69741953-99ac-44ec-9ae8-7baf1d352b1e"
                  }
                },
                "Add_a_new_row_to_TicketUpdates_table_1": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "parameters": {
                      "entityName": "f26c_ticketupdates",
                      "item/f26c_TicketID@odata.bind": "@concat('f26c_tickets(', actions('Get_ticket')?['inputs']?['parameters']?['recordId'], ')')",
                      "item/f26c_UpdatedBy@odata.bind": "@concat('f26c_employees(', outputs('Get_assignee')?['body/f26c_employeeid'], ')')",
                      "item/f26c_updatedon": "@utcNow()",
                      "item/f26c_updatetype": 751610003,
                      "item/f26c_updatetext": "@variables('notes')"
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                      "operationId": "CreateRecord",
                      "connectionName": "shared_commondataserviceforapps"
                    }
                  },
                  "runAfter": {
                    "Updates_a_ticket_to_skip": [
                      "Succeeded"
                    ]
                  },
                  "metadata": {
                    "operationMetadataId": "9dbbe4eb-01e2-413f-b8c1-9243de5f2fd4"
                  }
                }
              },
              "case": "skip"
            },
            "Case_transfer": {
              "actions": {
                "Get_new_assignee_": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "parameters": {
                      "entityName": "f26c_employees",
                      "recordId": "@variables('transferTo')"
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                      "operationId": "GetItem",
                      "connectionName": "shared_commondataserviceforapps"
                    }
                  },
                  "metadata": {
                    "operationMetadataId": "c01b739c-668d-4562-9706-3853d71ec511"
                  }
                },
                "Post_message_in_a_chat_or_channel": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "parameters": {
                      "poster": "Flow bot",
                      "location": "Chat with Flow bot",
                      "body/recipient": "@outputs('Get_new_assignee_')?['body/f26c_email']",
                      "body/messageBody": "<p class=\"editor-paragraph\">A ticket has been transferred to you.<br><br>Ticket: @{outputs('Updates_a_ticket_for_transfer')?['body/f26c_title']}<br>Ticket ID: @{outputs('Updates_a_ticket_for_transfer')?['body/f26c_id']}<br>Transferred by: @{outputs('Get_assignee')?['body/f26c_name']}<br><br>Work notes history :<br>@{outputs('Notes_history')}<br><br>You will receive a card shortly with options to resolve, skip, or transfer it.</p>"
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams",
                      "operationId": "PostMessageToConversation",
                      "connectionName": "shared_teams"
                    }
                  },
                  "runAfter": {
                    "Updates_a_ticket_for_transfer": [
                      "Succeeded"
                    ]
                  },
                  "metadata": {
                    "operationMetadataId": "dcbdc737-ad69-49d1-bfda-556424381909"
                  }
                },
                "List_ticket_updates": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "parameters": {
                      "entityName": "f26c_ticketupdates",
                      "$filter": "_f26c_ticketid_value eq '@{triggerOutputs()?['body/f26c_ticketid']}' and f26c_updatetext ne null",
                      "$orderby": "f26c_updatedon asc"
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                      "operationId": "ListRecords",
                      "connectionName": "shared_commondataserviceforapps"
                    }
                  },
                  "runAfter": {
                    "Add_a_new_row_to_TicketUpdates": [
                      "SUCCEEDED"
                    ]
                  }
                },
                "Select_notes": {
                  "type": "Select",
                  "inputs": {
                    "from": "@outputs('List_ticket_updates')?['body/value']",
                    "select": "@concat(\r\n  formatDateTime(item()?['f26c_updatedon'], 'yyyy-MM-dd HH:mm'),\r\n  ' - ',\r\n  coalesce(item()?['f26c_updatetext'], '')\r\n)"
                  },
                  "runAfter": {
                    "List_ticket_updates": [
                      "Succeeded"
                    ]
                  }
                },
                "Notes_history": {
                  "type": "Compose",
                  "inputs": "@join(body('Select_notes'), '<br>')",
                  "runAfter": {
                    "Select_notes": [
                      "Succeeded"
                    ]
                  }
                },
                "Updates_a_ticket_for_transfer": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "parameters": {
                      "entityName": "f26c_tickets",
                      "recordId": "@outputs('Get_ticket')?['body/f26c_ticketid']",
                      "item/f26c_status": 751610001,
                      "item/f26c_AssignedTo@odata.bind": "@concat('f26c_employees(', variables('transferTo'), ')')",
                      "item/f26c_worknotes": "@variables('notes')"
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                      "operationId": "UpdateOnlyRecord",
                      "connectionName": "shared_commondataserviceforapps"
                    }
                  },
                  "runAfter": {
                    "Notes_history": [
                      "Succeeded"
                    ]
                  },
                  "metadata": {
                    "operationMetadataId": "a3dfe1a9-2b61-4112-9ce7-dc36aa5c5760"
                  }
                },
                "Add_a_new_row_to_TicketUpdates": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "parameters": {
                      "entityName": "f26c_ticketupdates",
                      "item/f26c_TicketID@odata.bind": "@concat('f26c_tickets(', actions('Get_ticket')?['inputs']?['parameters']?['recordId'], ')')",
                      "item/f26c_UpdatedBy@odata.bind": "@concat('f26c_employees(', outputs('Get_assignee')?['body/f26c_employeeid'], ')')",
                      "item/f26c_updatedon": "@utcNow()",
                      "item/f26c_updatetype": 751610002,
                      "item/f26c_updatetext": "@concat(outputs('Get_assignee')?['body/f26c_name'], ': ', variables('notes'))"
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                      "operationId": "CreateRecord",
                      "connectionName": "shared_commondataserviceforapps"
                    }
                  },
                  "runAfter": {
                    "Get_new_assignee_": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "case": "transfer"
            }
          },
          "runAfter": {
            "Do_until": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "847181b3-c367-4d62-bbc0-3e2d6e0429a1"
          }
        }
      },
      "outputs": {}
    },
    "templateName": null
  },
