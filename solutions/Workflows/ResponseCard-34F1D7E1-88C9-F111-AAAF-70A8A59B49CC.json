          "type": "Until",
          "expression": "@equals(variables('isValid'),true)",
          "limit": {
            "count": 5,
            "timeout": "P7D"
          },
          "actions": {
            "Response_card": {
              "type": "OpenApiConnectionWebhook",
              "inputs": {
                "parameters": {
                  "poster": "Flow bot",
                  "location": "Chat with Flow bot",
                  "body/body/messageBody": "{\n  \"type\": \"AdaptiveCard\",\n  \"$schema\": \"http://adaptivecards.io/schemas/adaptive-card.json\",\n  \"version\": \"1.4\",\n  \"body\": [\n    { \"type\": \"TextBlock\", \"text\": \"@{triggerOutputs()?['body/f26c_id']}\", \"color\": \"Attention\", \"wrap\": true },\n    { \"type\": \"TextBlock\", \"text\": \"You claimed this issue\", \"weight\": \"Bolder\", \"size\": \"Medium\" },\n    { \"type\": \"TextBlock\", \"text\": \"@{triggerOutputs()?['body/f26c_summary']}\", \"wrap\": true },\n    { \"type\": \"Input.Text\", \"id\": \"notes\", \"label\": \"Work notes (required)\", \"placeholder\": \"What was done, why you're skipping, or why you're transferring\", \"isMultiline\": true },\n    {\n      \"type\": \"Input.ChoiceSet\",\n      \"id\": \"transferTo\",\n      \"label\": \"Transfer to (only for Transfer)\",\n      \"placeholder\": \"Select a department\",\n      \"choices\": @{body('Select')}\n    }\n  ],\n  \"actions\": [\n    { \"type\": \"Action.Submit\", \"title\": \"Mark resolved\", \"data\": { \"action\": \"resolve\" } },\n    { \"type\": \"Action.Submit\", \"title\": \"Skip\", \"data\": { \"action\": \"skip\" } },\n    { \"type\": \"Action.Submit\", \"title\": \"Transfer\", \"data\": { \"action\": \"transfer\" } }\n  ]\n}",
                  "body/body/updateMessage": "Thank you for looking into the issue!",
                  "body/body/recipient/to": "@outputs('Get_assignee')?['body/f26c_email']"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams",
                  "operationId": "PostCardAndWaitForResponse",
                  "connectionName": "shared_teams"
                }
              },
              "metadata": {
                "operationMetadataId": "ddb89d67-7809-4045-8d2b-bef3d928dc12"
              }
            },
            "Set_action_variable": {
              "type": "SetVariable",
              "inputs": {
                "name": "action",
                "value": "@coalesce(outputs('Response_card')?['body/data/action'], '')"
              },
              "runAfter": {
                "Set_transferTo_variable_": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "f7530f2a-35d2-490c-9468-fce0035874ad"
              }
            },
            "Set_notes_variable_": {
              "type": "SetVariable",
              "inputs": {
                "name": "notes",
                "value": "@coalesce(outputs('Response_card')?['body/data/notes'], '')"
              },
