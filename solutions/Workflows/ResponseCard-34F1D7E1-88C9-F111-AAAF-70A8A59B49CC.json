                "operationMetadataId": "60ab7e5d-482a-4cc5-b5af-c066a3ac53bd"
              }
            },
            "Set_isValid_variable_": {
              "type": "SetVariable",
              "inputs": {
                "name": "isValid",
                "value": "@and(\r\n  not(empty(trim(variables('notes')))),\r\n  or(\r\n    not(equals(variables('action'), 'transfer')),\r\n    and(\r\n      not(empty(variables('transferTo'))),\r\n      not(equals(toLower(variables('transferTo')), toLower(outputs('Get_assignee')?['body/f26c_employeeid'])))\r\n    )\r\n  )\r\n)"
              },
              "runAfter": {
                "Set_notes_variable_": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "f7e3b0ef-1862-4270-8cf8-f79b5304842c"
              }
            },
            "Set_errorMessage_variable_": {
              "type": "SetVariable",
              "inputs": {
                "name": "errorMessage",
                "value": "@if(variables('isValid'), '', 'Please add notes, and choose a department if you are transferring. Then try again.')"
              },
              "runAfter": {
                "Set_isValid_variable_": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "e9702769-68df-4928-a945-3739745c8126"
              }
            },
            "Set_transferTo_variable_": {
              "type": "SetVariable",
              "inputs": {
                "name": "transferTo",
                "value": "@coalesce(outputs('Response_card')?['body/data/transferTo'], '')"
              },
              "runAfter": {
