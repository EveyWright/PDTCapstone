            ]
          },
          "metadata": {
            "operationMetadataId": "72102c7d-de74-47eb-9b14-494873b96148"
          }
        },
        "Switch": {
          "type": "Switch",
          "expression": "@variables('action')",
          "default": {
            "actions": {
              "Terminate": {
                "type": "Terminate",
                "inputs": {
